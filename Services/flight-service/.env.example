PORT=3010
NODE_ENV=development

# Supabase PostgreSQL — same instance as every other service, own schema (crm_flights)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174

# ─── Flight Provider ─────────────────────────────────────────────────────
# Provider selection priority:
#   1. DUFFEL_ACCESS_TOKEN is set → DuffelClient
#   2. TRAVELPORT_MOCK_MODE is not 'false' → MockFlightClient (default)
#   3. Otherwise → TravelportClient

# ── Duffel ───────────────────────────────────────────────────────────────
# Set this to use Duffel as the flight provider (token-based auth, simpler setup).
# Get your token from https://duffel.com/dashboard
# Lushware's own Duffel account. Used ONLY for Lushware's agency (DUFFEL_LEGACY_TENANT_ID, else
# PUBLIC_SITE_TENANT_ID, else the demo agency). Every other agency connects its own Duffel account in
# Management > Settings > Integrations and never falls back to this one.
DUFFEL_ACCESS_TOKEN=
DUFFEL_WEBHOOK_SECRET=
DUFFEL_LEGACY_TENANT_ID=
# Where agency Duffel accounts are read from (default http://localhost:3015 outside production),
# and the shared internal token (same value as the other services).
INTEGRATION_SERVICE_URL=http://localhost:3015
# Airline-change emails to the booking rep (default http://localhost:3008 outside production).
NOTIFICATION_SERVICE_URL=http://localhost:3008
INTERNAL_EVENTS_TOKEN=
DUFFEL_CARD_CHECKOUT_ENABLED=false

# ── Travelport+ ──────────────────────────────────────────────────────────
# While true (default), returns realistic fake data instead of calling Travelport.
# Set to false once the Travelport vars below are filled in.
TRAVELPORT_MOCK_MODE=true

TRAVELPORT_ENV=sandbox
TRAVELPORT_TOKEN_URL=
TRAVELPORT_API_BASE_URL=
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_TARGET_BRANCH=
