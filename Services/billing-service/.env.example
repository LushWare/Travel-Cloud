# Supabase PostgreSQL — same instance as every other service, own schema (crm_billing)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PORT=3006
REDIS_URL=redis://localhost:6379

# user-service — org settings (company/branding/quotation defaults/bank details)
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me
STRIPE_SECRET_KEY=your_stripe_key
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# lead-service — communication-log entries for sent documents
LEAD_SERVICE_URL=http://localhost:3004

# notification-service — email + WhatsApp (Meta Cloud API) delivery.
# billing-service holds no email/WhatsApp provider credentials itself; it
# calls POST /notifications/internal/{email,whatsapp}. Must match
# notification-service's own INTERNAL_EVENTS_TOKEN.
NOTIFICATION_SERVICE_URL=http://localhost:3008
INTERNAL_EVENTS_TOKEN=shared_internal_service_token
INTEGRATION_SERVICE_URL=http://localhost:3015

# WhatsApp template names — only needed if your approved Meta templates use
# different names than these defaults. Not secrets (templates are public
# once approved), so plain overrides are fine here.
# WHATSAPP_TEMPLATE_QUOTATION=quotation_ready
# WHATSAPP_TEMPLATE_INVOICE=invoice_ready
# WHATSAPP_TEMPLATE_RECEIPT=payment_receipt_ready
# WHATSAPP_TEMPLATE_VOUCHER=travel_voucher_ready
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
