# Supabase PostgreSQL — same instance as every other service, own schema (crm_voice)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PORT=3012
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174

# Domain services this service calls while handling a call. Reach them through
# their own ports (the gateway is not in this path) — except ElevenLabs webhooks,
# which arrive through the gateway at /api/v1/webhooks/voice/*.
LEAD_SERVICE_URL=http://localhost:3004
PACKAGE_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3006
BOOKING_SERVICE_URL=http://localhost:3005
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3008
# Used by the voice-agent integration smoke test to drive tool endpoints through
# the gateway.
# GATEWAY_URL=http://localhost:3000

# Must match the values the services above use.
INTERNAL_SERVICE_KEY=change-me-internal-service-key
INTERNAL_EVENTS_TOKEN=shared_internal_service_token

# ─── ElevenLabs Conversational AI ──────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxx

# HMAC signing secret from the ElevenLabs workspace webhook configured for
# post_call_transcription. Required in every environment; no dev bypass.
ELEVENLABS_WEBHOOK_SECRET=your-elevenlabs-webhook-signing-secret

# Shared secrets configured on the agent's initiation webhook and eight tool
# webhooks. Keep these distinct from the ElevenLabs API key.
ELEVENLABS_INITIATION_SECRET=generate-a-long-random-secret
ELEVENLABS_TOOL_SECRET=generate-another-long-random-secret

# The workspace webhook is created by setup-voice-agent.mjs when this ID is
# absent. Save the returned id/secret here before rerunning the setup script.
# ELEVENLABS_POST_CALL_WEBHOOK_ID=wh_...

# ─── Phone number registration ────────────────────────────────────────────
ELEVENLABS_PHONE_NUMBER=+94112345678
# `cd Services && node setup-voice-agent.mjs [--apply]` syncs prompt, tools,
# initiation webhook and transcription webhook to the agent.
# `cd Services && node setup-voice-number.mjs [--show]` registers the answering
# number locally (the default run writes and deactivates any previous number).
# What the agent calls the business in its greeting and transfer copy.
VOICE_BRAND_LABEL=Lushware Travel
# Spoken at the start of every call. Keep it truthful — the call is recorded.
VOICE_DISCLOSURE_TEXT=You are speaking with an AI assistant, and this call is recorded.
# Public HTTPS gateway base URL where /api/v1/webhooks/voice/* resolves. Do not
# use the Management portal host; Firebase rewrites those paths to the SPA.
ELEVENLABS_PUBLIC_BASE_URL=https://api.lushtravelcloud.com

# Calls from one number this service will act on per rolling 24h (default 20).
# Past the cap the call is still answered and still recorded in full — it just
# stops being forwarded into lead-service/notification-service.
VOICE_MAX_CALLS_PER_NUMBER_PER_DAY=20
