# Supabase PostgreSQL — same instance as every other service, own schema (crm_assistant)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

CLIENT_URL=http://localhost:5173
PORT=3011
GEMINI_API_KEY=your_gemini_api_key
# Model used by the customer-facing assistant and grounded travel search.
GEMINI_MODEL=gemini-3.5-flash-lite
# Temporary client-first rollout gate. Keep false until the compatible Client
# bundle has propagated; remove after the tested rollback window.
ASSISTANT_CONVERSATIONAL_OUTCOMES_ENABLED=false
# Stage-one classifier configuration. The model is pinned independently from
# the resolver. Direct classes remain disabled until a real sanitized corpus
# passes the documented per-class evaluation gates.
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
ASSISTANT_ROUTER_SOCIAL_ENABLED=false
ASSISTANT_ROUTER_OFF_TOPIC_ENABLED=false
ASSISTANT_ROUTER_SOCIAL_THRESHOLD=0.95
ASSISTANT_ROUTER_OFF_TOPIC_THRESHOLD=0.95
# Grounded travel search (search_travel_info). ON unless this is exactly
# 'false' — the assistant's own web lookups are bounded by the travel-domain
# gate in src/ai/travelDomain.js, not by this flag. Set it to false in an
# environment that must not spend on Google-Search grounding at all; a missing
# GEMINI_API_KEY disables the tool independently.
ASSISTANT_TRAVEL_SEARCH_ENABLED=true


# Used by @travel-crm/policy-retrieval's fetchPolicyDocuments (imported by
# this service) to fetch the org's policy documents from user-service.
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me

# ─── Management business notifications ────────────────────────────────────
MANAGEMENT_NOTIFICATIONS_ENABLED=false
# Domain-service URLs used by assistant integrations.
LEAD_SERVICE_URL=http://localhost:3004
