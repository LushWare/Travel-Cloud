PORT=3000
NODE_ENV=development
# Shared rate limiting across gateway instances; required in production.
REDIS_URL=

# Public key(s) that check logins. Create with: node Services/create-login-keys.mjs
JWT_PUBLIC_KEYS=

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PACKAGE_SERVICE_URL=http://localhost:3003
LEAD_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
BILLING_SERVICE_URL=http://localhost:3006
FLIGHT_SERVICE_URL=http://localhost:3010
CAREER_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3009
ASSISTANT_SERVICE_URL=http://localhost:3011
VOICE_SERVICE_URL=http://localhost:3012

# Internal service-to-service key (not exposed to clients)
INTERNAL_SERVICE_KEY=change-me-internal-key

# CORS allowed origins
CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174
