PORT=3008
NODE_ENV=development

# Facebook Webhook
FACEBOOK_VERIFY_TOKEN=your_verify_token
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
GOOGLE_ADS_WEBHOOK_KEY=your_google_ads_webhook_key

# lead-service (Facebook leads are created via its internal API, not written
# directly to its tables — assignment is governed by lead-service's own
# Settings.assignmentMode, not a separate flag here)
LEAD_SERVICE_URL=http://localhost:3004
INTERNAL_EVENTS_TOKEN=shared_internal_service_token

# Email (Nodemailer) — notification-service is the only service that sends
# email directly; auth-service, booking-service, billing-service, and
# career-service call POST /api/v1/notifications/internal/email instead of
# holding their own SMTP config.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# WhatsApp (Meta Cloud API) — notification-service is the only service that
# holds Meta credentials; billing-service calls POST /notifications/internal/
# whatsapp instead of talking to Graph API directly (same pattern as email).
# Access token must be a System User PERMANENT token scoped to
# whatsapp_business_messaging + whatsapp_business_management — temporary
# tokens expire in ~24h. WHATSAPP_APP_SECRET signs inbound webhook payloads
# (X-Hub-Signature-256); WHATSAPP_VERIFY_TOKEN is a separate, unrelated
# secret used only for the one-time webhook subscription handshake.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=choose_a_random_string_and_register_it_in_meta
WHATSAPP_API_VERSION=v23.0
