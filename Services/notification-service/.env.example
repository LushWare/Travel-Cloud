PORT=3008
NODE_ENV=development

# lead-service (Facebook leads are created via its internal API, not written
# directly to its tables — assignment is governed by lead-service's own
# Settings.assignmentMode, not a separate flag here)
LEAD_SERVICE_URL=http://localhost:3004
INTERNAL_EVENTS_TOKEN=shared_internal_service_token
INTEGRATION_SERVICE_URL=http://localhost:3015

# Platform fallback email (Nodemailer). Agency SMTP credentials are stored
# encrypted by integration-service and are never placed in service env files.
# Auth-service, booking-service, billing-service, and career-service call
# POST /api/v1/notifications/internal/email rather than sending directly.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# WhatsApp Meta app credentials are platform-level and only used for webhook
# verification. Each agency's sender token and phone number are stored in the
# Integration Hub. During migration, the old global sender is allowed only
# for this explicitly configured tenant ID; leave blank to disable the fallback.
# billing-service calls POST /notifications/internal/whatsapp.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_LEGACY_TENANT_ID=
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=choose_a_random_string_and_register_it_in_meta
WHATSAPP_API_VERSION=v23.0
