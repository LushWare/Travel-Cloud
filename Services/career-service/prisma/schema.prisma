// =============================================================
// career-service — PostgreSQL schema: "careers"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • Career.resume embedded object → flattened columns.
//   • Vacancy.experience.min → experienceMin column.
//   • reviewedById / createdById are cross-schema UUID refs.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_careers"]
}

enum CareerStatus {
  pending
  under_review @map("under-review")
  shortlisted
  rejected
  hired

  @@schema("crm_careers")
}

enum VacancyType {
  Full_Time  @map("Full Time")
  Part_Time  @map("Part Time")
  Contract
  Temporary
  Internship

  @@schema("crm_careers")
}

enum VacancyStatus {
  active
  closed
  draft

  @@schema("crm_careers")
}

// ─── Career (job applications) ────────────────────────────────

model Career {
  id             String       @id @default(uuid())
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  fullName       String       @db.VarChar(100)
  email          String
  phone          String
  position       String
  resumeUrl      String?
  resumeFileName String?
  coverLetter    String       @db.VarChar(2000)
  agreeTerms     Boolean
  status         CareerStatus @default(pending)
  adminNotes     String?      @db.VarChar(2000)
  reviewedById   String?      // → users.User.id
  reviewedAt     DateTime?
  emailSent      Boolean      @default(false)
  emailSentAt    DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@index([position])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
  @@schema("crm_careers")
}

// ─── Vacancy (job postings) ───────────────────────────────────

model Vacancy {
  id                String        @id @default(uuid())
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  position          String        @db.VarChar(100)
  description       String        @db.VarChar(2000)
  type              VacancyType   @default(Full_Time)
  location          String
  experienceMin     Int           @default(0) // years; flattened from experience.min
  status            VacancyStatus @default(draft)
  applicationsCount Int           @default(0)
  createdById       String        // → users.User.id
  closingDate       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([position])
  @@index([tenantId])
  @@schema("crm_careers")
}
