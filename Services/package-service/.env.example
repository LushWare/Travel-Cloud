# Supabase PostgreSQL — same instance as every other service, own schema (crm_packages)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PORT=3003
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# AI providers: OpenAI answers first, Gemini is the automatic backup
# (src/ai/aiClient.js). Either key alone works.
OPENAI_API_KEY=your_openai_api_key
# Reasoning off keeps generation inside the Client's 15s abort window
# (measured: 2-day preview 8-10s at `none`, 13-20s at `low`).
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=none
GEMINI_API_KEY=your_gemini_api_key
# Optional, backup only. The code default is a THINKING model, and this service's AI routes
# are called by the customer Client, whose shared HTTP client aborts at 15s
# (Client/src/services/http/config.ts) — a thinking model loses that race. The
# lite tier does no thinking at all. Re-check this pin periodically as newer
# models mature.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used to fetch the org's configured branding (company name, tagline, logo,
# address, contact) for the package PDF's header/footer/letterhead (falls
# back to the static defaults below if unreachable).
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me

# Lead-service internal intake (service-to-service) — see docs/designs/chatbot-inbound-lead-intake.md
LEAD_SERVICE_URL=http://localhost:3004
# Must match lead-service's INTERNAL_EVENTS_TOKEN
INTERNAL_EVENTS_TOKEN=shared_internal_service_token

# Fallback values used only when user-service can't be reached and there's
# no cached response yet — normally these come from Organization Settings.
# COMPANY_NAME=Travel CRM
# COMPANY_TAGLINE=Your Travel Partner
# COMPANY_LOGO=
# COMPANY_ADDRESS=
# COMPANY_PHONE=
# COMPANY_EMAIL=
# COMPANY_WEBSITE=
# QUOTATION_RATING_TAGLINE=Rated 4.9  |  10k+ Travellers  |  30+ Destinations
