// =============================================================
// user-service — PostgreSQL schema: "users"
// Shared DB, isolated namespace. VendorProfile is a 1:1
// extension of User, only populated when role = vendor.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_users", "crm_platform"]
}

enum UserRole {
  customer
  salesRep
  vendor
  admin
  superAdmin

  @@schema("crm_users")
}

enum VendorStatus {
  pending_verification
  verified
  suspended
  rejected

  @@schema("crm_users")
}

enum ServiceType {
  hotel
  transport
  activity
  restaurant
  guide
  other

  @@schema("crm_users")
}

// Valid permission strings (validated in service layer, stored as text[]):
// manage_users | manage_sales_reps | manage_vendors | manage_admins
// view_reports | manage_billing | view_billing | manage_leads | manage_packages

model User {
  id                       String         @id @default(uuid())
  name                     String         @db.VarChar(50)
  email                    String         @unique @db.VarChar(255)
  phone                    String?
  phoneCountry             String?        @default("US") @db.VarChar(2)
  phoneE164                String?        @unique
  password                 String         // bcrypt hash — never exposed in API responses

  role                     UserRole       @default(customer)
  isSuperAdmin             Boolean        @default(false)
  permissions              String[]       // validated against allowed list in service layer
  commissionRate           Decimal?       @db.Decimal(5, 2) // sales reps only, percent 0–100

  avatarPublicId           String?
  avatarUrl                String?

  isActive                 Boolean        @default(true)
  isEmailVerified          Boolean        @default(false)
  isTempPassword           Boolean        @default(false)
  mustChangePassword       Boolean        @default(false)
  canBeDeleted             Boolean        @default(true)

  passwordChangedAt        DateTime?
  emailVerificationToken   String?
  emailVerificationExpire  DateTime?
  resetPasswordToken       String?
  resetPasswordExpire      DateTime?
  lastLogin                DateTime?
  lastActivity             DateTime       @default(now())

  // Self-referential within this schema
  createdById              String?
  createdBy                User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers             User[]         @relation("UserCreatedBy")

  vendorProfile            VendorProfile?
  memberships              Membership[]

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([role, isActive])
  @@index([lastActivity])
  @@schema("crm_users")
}

model VendorProfile {
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  id                          String       @id @default(uuid())
  userId                      String       @unique
  user                        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName                String?
  serviceType                 ServiceType?
  businessRegistrationNumber  String?     
  taxIdentificationNumber     String?

  // Address (flattened from Mongoose embedded object)
  addressStreet               String?
  addressCity                 String?
  addressState                String?
  addressZipCode              String?
  addressCountry              String?

  // Contact person (flattened)
  contactPersonName           String?
  contactPersonPhone          String?
  contactPersonEmail          String?
  contactPersonDesignation    String?

  // Bank details (flattened)
  bankAccountName             String?
  bankAccountNumber           String?
  bankName                    String?
  bankBranchName              String?
  bankIfscCode                String?
  bankSwiftCode               String?

  rating                      Float        @default(0)
  totalBookings               Int          @default(0)
  vendorStatus                VendorStatus @default(pending_verification)

  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  @@index([tenantId])

  @@unique([tenantId, businessRegistrationNumber])

  @@schema("crm_users")
}

// ─── Organization settings (singleton) ──────────────────────────
// Single row, enforced in the service layer (see organizationSettings.service.js),
// same convention as lead-service's Settings model. Replaces the env-var-driven
// branding.js config previously duplicated in billing-service and Management.
model OrganizationSettings {
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  id String @id @default(uuid())

  // Company identity
  companyName      String  @default("Lush Travel Cloud")
  companyShortName String?
  companyLegalName String?
  companyAddress   String? @db.Text
  companyGstNumber String?
  tagline          String?
  logoUrl          String?

  // Contact
  contactEmail   String?
  salesEmail     String?
  supportEmail   String?
  contactPhone   String?
  whatsappNumber String?
  website        String?

  // Theme (quotation PDF)
  themeInk        String? @default("#1F2937")
  themeMuted      String? @default("#64748B")
  themeAccent     String? @default("#F5A623")
  themeAccentDark String? @default("#D98A0B")

  // Quotation/document defaults
  defaultCurrency          String   @default("USD")
  defaultTaxRate           Decimal? @db.Decimal(5, 2)
  defaultServiceChargeRate Decimal? @db.Decimal(5, 2)
  quotationValidityDays    Int      @default(30)
  quotationTerms           String?  @db.Text
  cancellationPolicy       String?  @db.Text
  invoicePaymentTerms        String? @db.Text
  invoicePaymentInstructions String? @db.Text
  ratingTagline            String?
  paymentMethods           String[]
  docNumberPrefixes        Json? // { quotation, invoice, receipt, payment, creditNote, voucher }

  // Bank / payment details — sensitive, admin-only in every response path
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankSwiftCode     String?
  bankBranch        String?
  bankAccountType   String? @default("Current Account")
  upiId             String?

  updatedById String? // → users.User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Only one row allowed — enforced by getOrCreateSingleton() in service layer

  @@index([tenantId])

  @@unique([tenantId])

  @@schema("crm_users")
}

// ─── Policy documents (RAG-retrievable, admin-editable) ─────────
// Extends OrganizationSettings' existing single-string cancellationPolicy
// pattern into multiple, citable documents — what makes server-verified
// snippet citation possible for the trip-planning wizard's
// answer_policy_question tool (docs/designs/ai-trip-planning-assistant.md).
// Owner of editing these docs is the same admin/superAdmin role that already
// edits cancellationPolicy via PUT /admin/settings — no new role.
model PolicyDocument {
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  id    String @id @default(uuid())
  title String @db.VarChar(255)
  body  String @db.Text

  updatedById String? // → users.User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([tenantId])
  @@schema("crm_users")
}

// ─── Agencies (tenants) and who belongs to them ───────────────
// crm_platform is the tenant registry: not tenant-owned, so never under tenant RLS.

enum TenantStatus {
  trial
  active
  past_due
  suspended
  pending_deletion
  deleted

  @@schema("crm_platform")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(63)
  name        String       @db.VarChar(120)
  status      TenantStatus @default(trial)
  region      String       @default("ap-southeast-1") @db.VarChar(32)
  memberships Membership[]
    planAssignment TenantPlan?
    planOverrides PlanEntitlementOverride[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@schema("crm_platform")
}

// A plan is a stable catalog entry; each edit creates an immutable version so existing
// agencies can stay on the version and price they were assigned.
model Plan {
  id         String        @id @default(uuid()) @db.Uuid
  key        String        @unique @db.VarChar(64)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  versions   PlanVersion[]

  @@schema("crm_platform")
}

model PlanVersion {
  id              String       @id @default(uuid()) @db.Uuid
  planId          String       @db.Uuid
  version         Int
  name            String       @db.VarChar(120)
  description     String?      @db.VarChar(500)
  priceMinorUnits Int?
  currency        String       @default("USD") @db.Char(3)
  billingInterval String?      @db.VarChar(16)
  entitlements    Json
  isCurrent       Boolean      @default(false)
  createdById     String?
  createdAt       DateTime     @default(now())
  plan            Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignments     TenantPlan[]

  @@unique([planId, version])
  @@index([planId, isCurrent])
  @@schema("crm_platform")
}

model TenantPlan {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @unique @db.Uuid
  planVersionId   String      @db.Uuid
  priceMinorUnits Int?
  currency        String      @default("USD") @db.Char(3)
  assignedById    String?
  assignedAt      DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planVersion     PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([planVersionId])
  @@schema("crm_platform")
}

model PlanEntitlementOverride {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  entitlementKey String   @db.VarChar(64)
  value          Json
  reason         String   @db.VarChar(500)
  changedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entitlementKey])
  @@index([tenantId])
  @@schema("crm_platform")
}

// Append-only record of privileged actions. The services' database user may only INSERT and SELECT,
// and row-level security limits it to the current agency. tenantId is null only for platform events.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  actorId     String?
  actorEmail  String?  @db.VarChar(254)
  actorRole   String?  @db.VarChar(32)
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(32)
  targetId    String?  @db.VarChar(64)
  summary     String   @db.VarChar(300)
  details     Json?
  ipAddress   String?  @db.VarChar(64)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action])
  @@schema("crm_platform")
}

// Lushware staff who run the platform. Separate from agency users; only platform-service reads these.
enum PlatformRole {
  platform_admin
  support

  @@schema("crm_platform")
}

model PlatformUser {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique @db.VarChar(254)
  name             String            @db.VarChar(120)
  passwordHash       String
  mustChangePassword Boolean          @default(false) // true while the password is a generated, temporary one
  passwordChangedAt  DateTime?
  role             PlatformRole      @default(support)
  totpSecret       String // encrypted with PLATFORM_TOTP_KEY
  authenticatorSetupRequired Boolean @default(false)
  setupTokenHash   String?           @unique @db.Char(64)
  setupTokenExpiresAt DateTime?
  setupPurpose     String?            @db.VarChar(32)
  lastTotpStep     BigInt            @default(0)
  isActive         Boolean           @default(true)
  failedLoginCount Int               @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         PlatformSession[]
  helpAccessGrants HelpAccessGrant[]

  @@schema("crm_platform")
}

model PlatformSession {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @db.Uuid
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @db.Char(64)
  ipAddress      String?      @db.VarChar(64)
  userAgent      String?      @db.VarChar(300)
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([platformUserId])
  @@schema("crm_platform")
}

// View-only help access to one agency for at most 30 minutes (see platform-service).
model HelpAccessGrant {
  id               String    @id @default(uuid()) @db.Uuid
  platformUserId   String?   @db.Uuid
  platformUser     PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  tenantId         String    @db.Uuid
  reason           String    @db.VarChar(500)
  handoffCodeHash  String    @unique @db.Char(64)
  handoffExpiresAt DateTime
  handoffUsedAt    DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  endedAt          DateTime?

  @@index([tenantId])
  @@index([platformUserId])
  @@schema("crm_platform")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@schema("crm_users")
}

/// A person's access to one agency. The same User can belong to several agencies, with a role in each.
model Membership {
  id          String           @id @default(uuid())
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole
  permissions String[]
  isOwner     Boolean          @default(false)
  status      MembershipStatus @default(invited)
  invitedById String?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@schema("crm_users")
}
