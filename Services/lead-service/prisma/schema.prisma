// =============================================================
// lead-service — PostgreSQL schema: "leads"
// Shared DB, isolated namespace.
//
// Design decisions (2026-08-02 rebuild):
//   • Lifecycle is driven by lifecycleStatus; the legacy `status` enum and
//     LeadStatusOption table are removed.
//   • The package blueprint is copied once (NEW → DRAFTING) into lead-owned
//     itinerary tables (LeadItineraryDay + children) with snapshotted prices.
//   • Pricing is relational: LeadPricing (currency, margin, deposit plan,
//     computed totals) + LeadCostLine[] (basis, est/actual, margin override,
//     source AUTO|MANUAL).
//   • Optional transfer flights are LeadOptionalFlight rows (pricing + state).
//   • Cross-schema refs are plain UUID strings (no FK across schemas).
//   • Enum values mirror @travel-crm/constants (asserted by tests).
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_leads"]
}

// ─── Enums ─────────────────────────────────────────────────────

enum LeadSource {
  manual
  website
  booking
  facebook
  instagram
  google_ads    @map("google-ads")
  phone_call   @map("phone-call")
  email
  referral
  walk_in      @map("walk-in")
  other
  chatbot
  voice_agent  @map("voice-agent")

  @@schema("crm_leads")
}

enum LeadPlatform {
  Manual_Entry @map("Manual Entry")
  Website_Form @map("Website Form")
  Paid_Package @map("Paid Package")
  Facebook
  Instagram
  Google_Ads   @map("Google Ads")
  Phone_Call   @map("Phone Call")
  Email        @map("Email")
  Referral     @map("Referral")
  Walk_in      @map("Walk-in")
  Chatbot_Wizard @map("Chatbot Wizard")
  Voice_Agent  @map("Voice Agent")

  @@schema("crm_leads")
}

enum LeadLifecycleStatus {
  PENDING_VERIFICATION
  NEW
  DRAFTING
  QUOTED
  REVISION
  APPROVED
  BOOKING_IN_PROGRESS
  CONFIRMED
  CLOSED_LOST
  BOOKING_FAILED
  CANCELLED

  @@schema("crm_leads")
}

enum LeadPriority {
  low
  medium
  high

  @@schema("crm_leads")
}

enum AssignmentMode {
  manual
  auto

  @@schema("crm_leads")
}

enum AssignmentStrategy {
  round_robin
  load_based

  @@schema("crm_leads")
}

enum CommunicationLogType {
  call
  email
  meeting
  message
  whatsapp
  other

  @@schema("crm_leads")
}

// ─── Pricing enums (mirror @travel-crm/constants) ──────────────

enum PricingBasis {
  PER_PERSON
  PER_ROOM
  PER_VEHICLE
  PER_KM
  FIXED

  @@schema("crm_leads")
}

enum MarginType {
  PERCENTAGE
  FIXED

  @@schema("crm_leads")
}

enum CostLineSource {
  AUTO
  MANUAL

  @@schema("crm_leads")
}

enum OptionalFlightType {
  TO_START
  RETURN_HOME

  @@schema("crm_leads")
}

enum StatusHistoryActor {
  USER
  SYSTEM

  @@schema("crm_leads")
}

enum DiscountType {
  none
  percentage
  fixed

  @@schema("crm_leads")
}

enum CostLineCategory {
  accommodation
  transportation
  activity
  food
  guide
  insurance
  visa
  package
  other

  @@schema("crm_leads")
}

// ─── Lead ──────────────────────────────────────────────────────

model Lead {
  id                 String       @id @default(uuid())
  name               String?
  email              String?
  phone              String?
  whatsapp           String?
  // Digits-only mirrors of phone/whatsapp. Lookups use these — the source
  // columns hold mixed formats (rep-created leads keep a leading `+`).
  phoneNormalized    String?
  whatsappNormalized String?
  city               String?
  source             LeadSource   @default(manual)
  platform           LeadPlatform @default(Manual_Entry)
  intakeChannel     String?
  intakeSessionId   String?
  fromCountry        String?
  destinationCountry String?
  destination        String?
  travelDate         DateTime?
  endDate            DateTime?

  // Cross-schema UUID refs
  convertedBookingId String? // → bookings.Booking.id
  currentItineraryId String? // → packages.Itinerary.id (editor ref)
  // The LeadPackageSelection currently driving the lead-level state-machine
  // gatekeepers (sellSubtotal/deposit/actuals checks) and default UI tab.
  // Auto-set to a lead's first selection; re-set to whichever selection is
  // quoted. A lead may have many selections (see LeadPackageSelection) — this
  // is a soft ref, not a FK, same pattern as the other cross-schema pointers.
  primarySelectionId String?
  leadDateTime       DateTime @default(now())
  numberOfTravelers  Int?
  budget             String?
  message            String?

  lifecycleStatus LeadLifecycleStatus @default(NEW)
  priority        LeadPriority        @default(medium)

  // Cross-schema UUID refs
  assignedToId   String? // → users.User.id (salesRep)
  assignedById   String? // → users.User.id (admin/auto)
  assignmentMode AssignmentMode @default(manual)

  packageSelections LeadPackageSelection[]

  // Notification preferences
  notifNewLead      Boolean @default(true)
  notifStatusChange Boolean @default(true)
  notifAssignment   Boolean @default(true)
  notifFollowUp     Boolean @default(true)

  followUpDate DateTime?
  lostReason   String?
  tags         String[]

  // Voice-agent provenance. Orthogonal to lifecycleStatus: a lead can be
  // REVISION and AI-touched and awaiting rep review at the same time.
  aiHandled        Boolean   @default(false)
  needsRepFollowup Boolean   @default(false)
  aiVerifiedAt     DateTime?
  aiVerifiedById   String? // → users.User.id

  remarks           LeadRemark[]
  statusHistory     LeadStatusHistory[]
  communicationLogs LeadCommunicationLog[]
  internalEvents    LeadInternalEvent[]
  customizedPackages CustomizedPackage[]
  manualItineraries  ManualItinerary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([intakeChannel, intakeSessionId])
  @@index([lifecycleStatus, createdAt])
  @@index([assignedToId, lifecycleStatus, createdAt])
  @@index([followUpDate])
  @@index([source, createdAt])
  @@index([platform])
  @@index([fromCountry, destinationCountry])
  @@index([leadDateTime])
  @@index([assignmentMode])
  @@index([city])
  @@index([primarySelectionId])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([phoneNormalized])
  @@index([whatsappNormalized])
  @@index([aiHandled])
  @@index([needsRepFollowup])
  @@schema("crm_leads")
}

// ─── Website-form ports: customized package & manual itinerary requests ──
// Minimum viable surface ported from the legacy monolith's CustomizedPackage
// /ManualItinerary models, following this service's own lean
// transaction-based website-lead pattern (see createWebsiteContactLead)
// rather than the legacy multi-document orchestration.

enum CustomizationRequestStatus {
  pending
  confirmed
  cancelled

  @@schema("crm_leads")
}

model CustomizedPackage {
  id                 String                     @id @default(uuid())
  leadId             String
  lead               Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  originalPackageId  String
  name               String
  description        String?
  destination        String
  duration           Int
  price              Decimal                    @db.Decimal(12, 2)
  maxGroupSize       Int                        @default(10)
  category           String?
  images             Json?
  coverImage         Json?
  inclusions         Json?
  exclusions         Json?
  highlights         Json?
  terms              Json?
  days               Json?
  status             CustomizationRequestStatus @default(pending)
  customizationNotes String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([leadId])
  @@index([originalPackageId])
  @@index([createdAt])
  @@schema("crm_leads")
}

model ManualItinerary {
  id        String                     @id @default(uuid())
  leadId    String
  lead      Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  days      Json
  status    CustomizationRequestStatus @default(pending)
  version   Int                        @default(1)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([leadId])
  @@index([createdAt])
  @@schema("crm_leads")
}

// ─── Package selections (per-package itinerary/pricing/quote state) ────────
//
// A lead can hold many packages at once (plus at most one manual/no-package
// slot). Each selection owns its own itinerary/cost-line/pricing/quote
// pointer. Children are lazily materialized: a pristine selection (no
// itineraryDays/pricing rows) is derived on read from the live package
// blueprint; persisted rows only appear once the rep edits the selection or
// a quotation is sent for it. "Refresh from original package" deletes the
// persisted rows to revert a selection back to pristine.
model LeadPackageSelection {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  packageId   String? // → packages.Package.id; null for the manual slot
  isManual    Boolean @default(false)
  packageName String? // denormalised snapshot, refreshed on (re)materialize

  // Rep-entered override for the quotation's destination text, set with
  // explicit confirmation in Management when it differs from the selected
  // package's own destination. Wins over both the package's and the lead's
  // own (often just an inquiry-stage placeholder) destination.
  destinationOverride String?

  // packageId this selection's persisted rows were last materialized from,
  // verbatim. Null when pristine (nothing persisted yet) or once edited.
  sourcePackageId String?

  // Quotation handoff (billing-service), now per selection.
  currentQuoteId  String? // → billing.Quotation.id
  quoteAcceptedAt DateTime?

  // Set when the voice agent edits this selection's itinerary, so a rep can
  // see what changed before accepting it: { beforeNights, afterNights,
  // beforeHotel, afterHotel, beforeDestination, afterDestination, summary,
  // changedAt }. Only the MOST RECENT pending edit is kept — the full
  // per-call history lives in crm_voice.VoiceCallEvent. Cleared when a rep
  // approves it, or by refreshSelection() (the "Discard" path).
  pendingAiChange Json?

  pricing         LeadPricing?
  costLines       LeadCostLine[]
  itineraryDays   LeadItineraryDay[]
  optionalFlights LeadOptionalFlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, packageId])
  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Lead child tables ─────────────────────────────────────────

model LeadRemark {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String?
  addedById String? // → users.User.id
  date      DateTime @default(now())
  addedAt   DateTime @default(now())

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadStatusHistory {
  id          String             @id @default(uuid())
  leadId      String
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String
  actor       StatusHistoryActor @default(USER)
  changedById String? // → users.User.id
  changedAt   DateTime           @default(now())
  notes       String?

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadCommunicationLog {
  id     String                @id @default(uuid())
  leadId String
  lead   Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date   DateTime              @default(now())
  type   CommunicationLogType?
  notes  String?
  externalMessageId String?
  byId   String? // → users.User.id

  @@unique([leadId, externalMessageId])
  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Internal event log (billing → lead webhooks) ─────────────

model LeadInternalEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  payload     Json?
  processedAt DateTime @default(now())

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Pricing (relational) ──────────────────────────────────────

model LeadPricing {
  id                     String               @id @default(uuid())
  leadPackageSelectionId String               @unique
  leadPackageSelection   LeadPackageSelection @relation(fields: [leadPackageSelectionId], references: [id], onDelete: Cascade)

  currency String @default("USD") @db.VarChar(3)

  marginType        MarginType?
  marginValue       Decimal?     @db.Decimal(12, 2)
  depositType       MarginType?
  depositValue      Decimal?     @db.Decimal(12, 2)
  discountType      DiscountType @default(none)
  discountValue     Decimal      @default(0) @db.Decimal(12, 2)
  serviceChargeRate Decimal      @default(0) @db.Decimal(12, 2)

  estimatedTotal      Decimal  @default(0) @db.Decimal(12, 2)
  actualTotal         Decimal? @db.Decimal(12, 2)
  sellSubtotal        Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  taxableSubtotal     Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal  @default(0) @db.Decimal(12, 2)
  depositAmount       Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal  @default(0) @db.Decimal(12, 2)
  profit              Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("crm_leads")
}

model LeadCostLine {
  id                     String               @id @default(uuid())
  leadPackageSelectionId String
  leadPackageSelection   LeadPackageSelection @relation(fields: [leadPackageSelectionId], references: [id], onDelete: Cascade)

  category           CostLineCategory
  description        String
  basis              PricingBasis
  quantity           Int              @default(1)
  estimatedUnitPrice Decimal          @default(0) @db.Decimal(12, 2)
  actualUnitPrice    Decimal?         @db.Decimal(12, 2)
  quotedUnitPrice    Decimal          @default(0) @db.Decimal(12, 2)
  estimatedTotal     Decimal          @default(0) @db.Decimal(12, 2)
  actualTotal        Decimal?         @db.Decimal(12, 2)
  sellTotal          Decimal          @default(0) @db.Decimal(12, 2)
  marginType         MarginType?
  marginValue        Decimal?         @db.Decimal(12, 2)
  source             CostLineSource   @default(AUTO)
  dayNumber          Int?
  flightBookingId    String?
  optionalFlightId   String? // → leads.LeadOptionalFlight.id (same schema)
  orderIndex         Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadPackageSelectionId])
  @@schema("crm_leads")
}

// ─── Copied itinerary (detached package copy) ──────────────────

model LeadItineraryDay {
  id                     String               @id @default(uuid())
  leadPackageSelectionId String
  leadPackageSelection   LeadPackageSelection @relation(fields: [leadPackageSelectionId], references: [id], onDelete: Cascade)
  dayNumber              Int
  title                  String?
  description            String?
  breakfastCount         Int                  @default(0)
  lunchCount             Int                  @default(0)
  dinnerCount            Int                  @default(0)
  mealPriceOverride      Decimal?             @db.Decimal(12, 2)
  accommodation          Json                 @default("{}")
  flights                Json                 @default("[]")

  places     LeadDayPlace[]
  activities LeadDayActivity[]
  transports LeadDayTransport[]
  images     LeadDayImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadPackageSelectionId, dayNumber])
  @@index([leadPackageSelectionId])
  @@schema("crm_leads")
}

model LeadDayPlace {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  placeId            String? // → packages.Place.id (snapshot ref)
  customName         String?
  orderIndex         Int              @default(0)

  @@unique([leadItineraryDayId, orderIndex])
  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

model LeadDayActivity {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  activityId         String? // → packages.ActivityCatalog.id (snapshot ref)
  name               String?
  description        String? // snapshot of packages.ActivityCatalog.description at selection time
  defaultCost        Decimal?         @db.Decimal(12, 2)
  costOverride       Decimal?         @db.Decimal(12, 2)
  orderIndex         Int              @default(0)

  @@unique([leadItineraryDayId, orderIndex])
  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

model LeadDayImage {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  url                String
  altText            String?
  orderIndex         Int              @default(0)

  @@unique([leadItineraryDayId, orderIndex])
  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

model LeadDayTransport {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  routeType          String?
  transportMode      String?
  pricingModel       String?
  unitCost           Decimal          @default(0) @db.Decimal(12, 2)
  distanceKm         Decimal?         @db.Decimal(8, 2)
  origin             String?
  destination        String?

  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

// ─── Optional transfer flights ─────────────────────────────────

model LeadOptionalFlight {
  id                     String               @id @default(uuid())
  leadPackageSelectionId String
  leadPackageSelection   LeadPackageSelection @relation(fields: [leadPackageSelectionId], references: [id], onDelete: Cascade)
  flightType             OptionalFlightType
  origin                 String?
  destination            String?
  date                   DateTime?
  cabinClass             String?
  departureTime          String?
  airlinePreference      String?
  notes                  String?
  flightBookingId        String? // → flights.FlightBooking.id
  status                 String               @default("PENDING")
  estimatedUnitPrice     Decimal              @default(0) @db.Decimal(12, 2)
  actualUnitPrice        Decimal?             @db.Decimal(12, 2)
  quantity               Int                  @default(1)
  marginType             MarginType?
  marginValue            Decimal?             @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadPackageSelectionId])
  @@schema("crm_leads")
}

// ─── Settings (singleton) ──────────────────────────────────────

model Settings {
  id                    String             @id @default(uuid())
  singletonKey          Int                @unique @default(1)
  assignmentMode        AssignmentMode     @default(manual)
  autoStrategy          AssignmentStrategy @default(round_robin)
  enabledSalesRepIds    String[] // → users.User.id[]
  roundRobinIndex       Int                @default(0)
  maxOpenLeadsPerRep    Int                @default(100)
  skipInactive          Boolean            @default(true)
  requireActiveLogin48h Boolean            @default(false)
  updatedById           String? // → users.User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // singletonKey is a fixed sentinel (always 1) — the @unique constraint is
  // what actually enforces "only one row" now; upsert on it everywhere.

  @@schema("crm_leads")
}
