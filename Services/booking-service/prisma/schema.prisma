// =============================================================
// booking-service — PostgreSQL schema: "bookings"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • Booking.travelers[] embedded array → BookingTraveler table.
//   • All cross-schema refs are plain UUID strings.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_bookings"]
}

enum PaymentStatus {
  pending
  partial
  paid
  refunded

  @@schema("crm_bookings")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed

  @@schema("crm_bookings")
}

enum TravelerGender {
  male
  female
  other

  @@schema("crm_bookings")
}

// ─── Booking ──────────────────────────────────────────────────

model Booking {
  id                  String        @id @default(uuid())
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid

  // Cross-schema UUID refs
  userId              String        // → users.User.id (customer)
  packageId           String        // → packages.Package.id
  invoiceId           String?       // → billing.Invoice.id
  assignedToId        String?       // → users.User.id (salesRep)

  travelDate          DateTime?
  endDate             DateTime?
  numberOfTravelers   Int
  totalAmount         Float
  paidAmount          Float         @default(0)
  paymentStatus       PaymentStatus @default(pending)
  bookingStatus       BookingStatus @default(pending)

  specialRequests     String?
  notes               String?

  cancelledAt         DateTime?
  cancellationReason  String?
  confirmedAt         DateTime?
  completedAt         DateTime?

  travelers           BookingTraveler[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([bookingStatus])
  @@index([travelDate])
  @@index([assignedToId])
  @@index([endDate])
  @@index([tenantId])
  @@schema("crm_bookings")
}

// ─── BookingTraveler ──────────────────────────────────────────

model BookingTraveler {
  id        String          @id @default(uuid())
  tenantId String @default(dbgenerated("(nullif(current_setting('app.tenant_id', true), ''))::uuid")) @db.Uuid
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  age       Int
  gender    TravelerGender?
  idType    String?
  idNumber  String?

  @@index([bookingId])
  @@index([tenantId])
  @@schema("crm_bookings")
}
