{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Incremental migration: existing .jsx/.js keep compiling untyped
       until explicitly renamed to .tsx/.ts. Do not flip checkJs on
       until the whole app has been migrated (see the Phase 6 strictness
       ramp in PRODUCTIONIZATION_PROGRESS.md) — turning it on early would
       flood every untouched file with errors unrelated to whatever is
       being worked on. */
    "allowJs": true,
    "checkJs": false,

    /* Full strict mode — every feature folder migrated (Phase 5), Header/
       Footer/App/main converted (Phase 6.1), context/ renamed to
       contexts/ (Phase 6.2). This is Phase 6.3. */
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "src-new"]
}
