# Management App Environment Variables - Example
# Copy this file to .env.local and fill in the values

# ==========================================
# API Configuration
# ==========================================
VITE_API_URL=http://localhost:3000/api/v1
# Image uploads go through the gateway to package-service, which holds the
# Cloudinary credentials server-side — no client-side upload key is needed.

# ==========================================
# APP Configuration
# ==========================================
VITE_APP_NAME=Lush Travel Cloud Management
VITE_APP_VERSION=1.0.0

# ==========================================
# COMPANY BRANDING (Customize for each client)
# ==========================================
VITE_COMPANY_NAME=Lush Travel Cloud
VITE_COMPANY_SHORT_NAME=LTC
VITE_COMPANY_TAGLINE=Your Travel Partner
VITE_COMPANY_LEGAL_NAME=LUSH Ware

# Contact Information
VITE_COMPANY_EMAIL=info@yourcompany.com
VITE_SUPPORT_EMAIL=support@yourcompany.com
VITE_COMPANY_PHONE=+1-800-000-0000

# Website
VITE_COMPANY_WEBSITE=https://www.yourcompany.com

# ==========================================
# OPTIONAL: Development Settings
# ==========================================
# Set to 'true' to show test credentials on login page (development only)
VITE_SHOW_TEST_CREDENTIALS=false

# ==========================================
# FEATURE FLAGS
# ==========================================
# Management Context Copilot panel (src/pages/LeadManagement.tsx).
# Build-time gate, not a runtime toggle: any value other than the exact string
# 'true' leaves the copilot disabled *and* strips its component tree from the
# production bundle. CI's deploy-hosting job sets this for the deployed build,
# so keep this in sync when it should be on.
